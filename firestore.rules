rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ok == true;
    }

    // Public content: anyone can read, only admins can write.
    match /site/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /awards/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /press/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /events/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{doc}  { allow read: if true; allow write: if isAdmin(); }

    // Contact form: visitors may send a message, only admins can read or delete.
    match /messages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','topic','message','createdAt','read'])
                    && request.resource.data.name is string && request.resource.data.name.size() < 200
                    && request.resource.data.email is string && request.resource.data.email.size() < 200
                    && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // Administrators: documents named by user UID, created by hand in the console.
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
